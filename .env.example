# ============================================================
# Mẫu biến môi trường cho gói Docker (BT3). Sao chép rồi chạy:
#     cp .env.example .env
#     docker compose up -d --build
# .env nằm trong .gitignore – KHÔNG commit. Giá trị dưới đây chỉ là MẪU
# chạy được cho máy thử; khi triển khai thật phải ĐỔI mọi giá trị.
# (Chạy Rails trực tiếp trên máy, không dùng Docker, thì không cần tệp .env.)
# ============================================================

# Cổng mở ra máy chủ: http://localhost:APP_PORT. Cổng 3000 bị chiếm thì đổi số khác.
APP_PORT=3000

# PostgreSQL – dịch vụ db tạo tài khoản này ở lần chạy đầu, app dùng nó để kết nối.
# Tên CSDL: DB_NAME (chính) và DB_NAME_cache / _queue / _cable (Solid Cache, Queue, Cable).
DB_NAME=smartcrm
DB_USER=smartcrm
DB_PASSWORD=doi-mat-khau-nay

# Khóa ký cookie / phiên đăng nhập của Rails (production). Khóa thật sinh bằng:
#     openssl rand -hex 64
SECRET_KEY_BASE=thay-bang-chuoi-ngau-nhien-sinh-boi-openssl-rand-hex-64-khi-trien-khai-that

# Số luồng Puma = số kết nối CSDL tối đa của mỗi tiến trình (NFR03)
RAILS_MAX_THREADS=5

# Mức ghi log: debug | info | warn | error
RAILS_LOG_LEVEL=info
