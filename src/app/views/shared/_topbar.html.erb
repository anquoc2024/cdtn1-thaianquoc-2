<%# Thanh tiêu đề: tên + vai trò của người đang đăng nhập và nút Đăng xuất (TD-24) %>
<header class="topbar">
  <div class="topbar__brand">
    <i class="ph ph-wrench topbar__logo" aria-hidden="true"></i>
    <b>TRUNG TÂM BẢO HÀNH</b>
    <small>Hệ thống tiếp nhận yêu cầu</small>
  </div>

  <div class="topbar__right">
    <div class="topbar__profile">
      <span class="topbar__avatar"><%= current_user.initials %></span>
      <span class="topbar__who">
        <b><%= current_user.full_name %></b>
        <small><%= current_user.role_label %></small>
      </span>
    </div>

    <%= button_to session_path, method: :delete, class: "topbar__logout",
                  form: { data: { turbo_confirm: "Đăng xuất khỏi hệ thống?" } } do %>
      <i class="ph ph-sign-out" aria-hidden="true"></i><span>Đăng xuất</span>
    <% end %>
  </div>
</header>
