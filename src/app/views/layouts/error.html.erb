<%# Layout riêng cho trang lỗi: KHÔNG gọi CSDL, không cần đăng nhập, CSS viết sẵn trong trang (TD-27) %>
<!DOCTYPE html>
<html lang="vi">
  <head>
    <title><%= @error_title %> · Trung tâm bảo hành</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <style>
      :root { --blue: #1e5aa8; --navy: #1e3a6e; --red: #c0392b; --line: #e3e7ee; --muted: #5b6575; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px;
             background: #f4f6fa; color: #1f2733; font: 16px/1.55 system-ui, "Segoe UI", Roboto, sans-serif; }
      .error-card { width: min(560px, 100%); background: #fff; border: 1px solid var(--line);
                    border-top: 4px solid var(--red); border-radius: 10px; padding: 28px 28px 24px;
                    box-shadow: 0 6px 24px rgba(20, 40, 80, .08); }
      .error-card__brand { margin: 0 0 18px; font-weight: 700; color: var(--navy); letter-spacing: .02em; }
      .error-card__status { margin: 0; font-size: 13px; font-weight: 700; color: var(--red); }
      .error-card h1 { margin: 4px 0 10px; font-size: 22px; line-height: 1.3; }
      .error-card p { margin: 0 0 18px; color: var(--muted); }
      .lookup { margin: 0 0 22px; padding: 12px 14px; background: #f7f8fb; border: 1px dashed #b8c2d3; border-radius: 8px; }
      .lookup span { display: block; font-size: 13px; color: var(--muted); }
      .lookup code { font: 600 15px/1.4 ui-monospace, Consolas, monospace; word-break: break-all; }
      .actions { display: flex; flex-wrap: wrap; gap: 10px; }
      .btn { display: inline-block; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; }
      .btn--primary { background: var(--blue); color: #fff; }
      .btn--ghost { border: 1px solid var(--line); color: var(--navy); }
      .btn:focus-visible { outline: 3px solid #9cc0f0; outline-offset: 2px; }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
