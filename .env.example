# ============================================================
# Mẫu biến môi trường – sao chép thành .env rồi sửa giá trị:
#     cp .env.example .env
# .env đã nằm trong .gitignore, không được đẩy lên GitHub.
#
# Rails KHÔNG tự đọc tệp .env. Nạp vào terminal trước khi chạy:
#     set -a; source .env; set +a
# Nếu không đặt biến nào, môi trường phát triển vẫn chạy được với
# cấu hình mặc định trong src/config/database.yml (kết nối qua socket,
# user PostgreSQL trùng tên user Ubuntu).
# ============================================================

# Cơ sở dữ liệu (PostgreSQL 18) – dạng postgres://user:mat_khau@host:cong/ten_csdl
DATABASE_URL=postgres://quoc:doi_mat_khau_nay@localhost:5432/src_development

# Cổng chạy web (mặc định 3000)
PORT=3000

# Số luồng Puma = số kết nối tối đa trong pool CSDL (NFR03 – ≥ 50 người dùng đồng thời)
RAILS_MAX_THREADS=5

# Môi trường chạy: development | test | production
RAILS_ENV=development

# Chỉ cần khi chạy production: nội dung tệp src/config/master.key
RAILS_MASTER_KEY=dan_noi_dung_master_key_vao_day
